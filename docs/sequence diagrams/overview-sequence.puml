@startuml High-level Overview

actor Client

participant Router
participant RequestDispatcher
participant RouterContext
participant MiddlewarePipeline
participant RouteRegistry
participant RouteHandler

Client -> Router : handle(req, res)

Router -> RequestDispatcher : dispatch(req, res, context)

RequestDispatcher -> RouterContext : getMiddlewarePipeline()
RouterContext --> RequestDispatcher : MiddlewarePipeline

RequestDispatcher -> MiddlewarePipeline : execute(req, res)
MiddlewarePipeline --> RequestDispatcher

alt Response already sent
    RequestDispatcher --> Client : Response
else Continue
    RequestDispatcher -> RouterContext : getRouteRegistry()
    RouterContext --> RequestDispatcher : RouteRegistry

    RequestDispatcher -> RouteRegistry : find(method, url)

    alt Route found
        RouteRegistry --> RequestDispatcher : RouteMatch

        RequestDispatcher -> RouteHandler : handler(req, res)
        RouteHandler --> Client : Response
    else Route not found
        RouteRegistry --> RequestDispatcher : null
        RequestDispatcher --> Client : 404 Not Found
    end
end

@enduml