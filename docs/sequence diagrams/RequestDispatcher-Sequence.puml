@startuml Dispatch

participant RequestDispatcher
participant RouteRegistry
participant MiddlewarePipeline
participant Middleware1
participant Middleware2
participant MiddlewareN
participant RouteHandler

RequestDispatcher -> RequestDispatcher : normalizeUrl(req)

RequestDispatcher -> RouteRegistry : find(method, url)

alt Route found
    RouteRegistry --> RequestDispatcher : RouteMatch
    RequestDispatcher -> RequestDispatcher : Attach params\nreq.params = route.params
else Route not found
    RouteRegistry --> RequestDispatcher : null
end

RequestDispatcher -> MiddlewarePipeline : execute(req, res)

activate MiddlewarePipeline

MiddlewarePipeline -> Middleware1 : invoke(req, res, next)
activate Middleware1

Middleware1 -> Middleware2 : next()
activate Middleware2

Middleware2 -> MiddlewareN : next()
activate MiddlewareN

MiddlewareN --> Middleware2
deactivate MiddlewareN

Middleware2 --> Middleware1
deactivate Middleware2

Middleware1 --> MiddlewarePipeline
deactivate Middleware1

MiddlewarePipeline --> RequestDispatcher
deactivate MiddlewarePipeline

alt Response already sent (res.writableEnded || req.handled)
    RequestDispatcher --> RequestDispatcher : return
else Continue
    alt Route found
        RequestDispatcher -> RouteHandler : handler(req, res)
        RouteHandler --> RequestDispatcher
    else Route not found
        RequestDispatcher --> RequestDispatcher : res.end(404)
    end
end

@enduml
